{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 0
  },
  "PasswordGenerator": {
    "Key": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 0,
    "EnableSsl": true,
    "From": "",
    "Username": "",
    "Password": ""
  },
  "LOMsSettings": {
    "CourtSessionReminder": {
      "ReminderDaysAhead": 1
    },
    "Pagination": {
      "DefaultPageNumber": 1,
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    },
    "Notification": {
      "EnableArabicFallback": true,
      "DefaultSenderEmail": "noreply@loms.local"
    },
    "Security": {
      "MinPasswordLength": 10,
      "EnableAuditLogging": true,
      "AllowedIpRanges": []
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    },
    "FileConcurrency": {
      "PermitLimit": 3,
      "QueueLimit": 10
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "loms-api"
    }
  }
}
