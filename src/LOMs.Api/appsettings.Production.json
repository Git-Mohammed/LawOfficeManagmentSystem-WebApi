{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Jwt": {
    "Issuer": "LOMsLawOffice",
    "Audience": "LOMsLawOfficeApi",
    "ExpiryMinutes": "60"
  },
  "PasswordGenerator": { },
  "Smtp": {
    "Host": "",
    "Port": 0,
    "EnableSsl": true,
    "From": ""
  },
  "LOMsSettings": {
    "CourtSessionReminder": { "ReminderDaysAhead": 1 },
    "Pagination": {
      "DefaultPageNumber": 1,
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    },
    "Notification": {
      "CourtSessionReminderDaysAhead": 1,
      "EnableArabicFallback": true,
      "DefaultSenderEmail": "noreply@loms.local"
    },
    "Security": {
      "MinPasswordLength": 10,
      "EnableAuditLogging": true,
      "AllowedIpRanges": []
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 1000,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 100
    },
    "FileConcurrency": {
      "PermitLimit": 5,
      "QueueLimit": 20
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": { "Microsoft": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "loms-api" }
  }
}
