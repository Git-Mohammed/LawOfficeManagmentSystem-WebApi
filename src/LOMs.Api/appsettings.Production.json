{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 0
  },

  "PasswordGenerator": {
    "Key": ""
  },

  "AppSettings": {
    "CorsPolicyName": "ProdCorsPolicy",
    "AllowedOrigins": [
      "https://law-office-management-sigma.vercel.app",
      "https://law-office-management-mu.vercel.app"
    ]
  },

  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    },
    "FileUploadConcurrency": {
      "PermitLimit": 3,
      "QueueLimit": 10
    }
  },

  "Smtp": {
    "Host": "",
    "Port": 0,
    "EnableSsl": true,
    "From": "",
    "Username": "",
    "Password": ""
  },

  "LOMsSettings": {
    "CourtSessionReminder": {
      "ReminderDaysAhead": 1
    },
    "Pagination": {
      "DefaultPageNumber": 1,
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    },
    "Notification": {
      "EnableArabicFallback": true
    },
    "Security": {
      "MinPasswordLength": 10,
      "EnableAuditLogging": true,
      "AllowedIpRanges": []
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.AspNetCore"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {}
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithCorrelationId"
    ],
    "Properties": {
      "Application": "loms-api-production"
    }
  }
}
