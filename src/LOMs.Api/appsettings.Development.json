  "Serilog": {
    /** 
     * Specifies the Serilog sinks (output targets) to be used.
     * - Console: logs to the terminal or hosting console.
     * - Seq: sends structured logs to a Seq server for centralized viewing and querying.
     */
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],

    /** 
     * Controls the minimum logging level globally and for specific namespaces.
     * - Default: logs Information and above (Warning, Error, etc.)
     * - Override: sets Microsoft logs to Information to reduce noise from internal framework logs.
     */
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },

    /** 
     * Defines where logs should be written.
     * - Console: outputs to terminal.
     * - Seq: sends logs to a Seq server.
     *   - serverUrl: the address of the Seq server (e.g., inside Docker network).
     *     ⚠️ Note: "http://ops.seq:5341" assumes the Seq container is named `seq` and reachable via Docker DNS.
     */
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://ops.seq:5341" // docker file
        }
      }
    ],

    /** 
     * Enrichers add contextual metadata to each log entry.
     * - FromLogContext: includes ambient context (e.g., request ID, user ID).
     * - WithMachineName: adds the machine name.
     * - WithThreadId: includes the thread ID for concurrency tracing.
     */
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],

    /** 
     * Static properties attached to every log entry.
     * - Application: custom tag to identify the source system (e.g., "api").
     *   Useful for filtering logs in Seq or other sinks.
     *   This value can be injected from a YAML file or environment variable if needed.
     */
    "Properties": {
      "Application": "api" // yamal file
    }
  }
}
